---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  iconOnly?: boolean;
  icon?: boolean | "envelope-simple" | "github-logo" | "instagram-logo" | "linkedin-logo" | "x-logo";
}

const { icon = false, iconOnly = false, class: className, ...attributes } = Astro.props;
const opensInNewTab = /^https?:\/\//i.test(attributes.href ?? "");
---

<a
  class:list={["inline-link", { "inline-link--icon-only": iconOnly }, className]}
  {...attributes}
  target={opensInNewTab ? "_blank" : undefined}
  rel={opensInNewTab ? "noopener noreferrer" : undefined}
>
  <slot />
  {icon && (
    <span
      class="inline-link__icon"
      style={`--inline-link-icon: url("/icons/phosphor/${typeof icon === "string" ? icon : "arrow-up-right"}.svg")`}
      aria-hidden="true"
    ></span>
  )}
</a>

<style>
  .inline-link {
    display: inline;
    padding: 0;
    color: var(--foreground-1);
    font: inherit;
    letter-spacing: inherit;
    text-decoration: none;
    /* Paint the underline without adding width or changing the line box. */
    box-shadow: 0 2px 0 var(--color-accent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: box-shadow 400ms var(--bezier);
  }

  .inline-link:hover,
  .inline-link:focus-visible {
    box-shadow: 0 2px 0 transparent;
  }

  .inline-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .inline-link__icon {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    margin-inline-start: 0.25em;
    vertical-align: middle;
    background-color: currentColor;
    mask: var(--inline-link-icon) center / contain no-repeat;
  }

  .inline-link--icon-only {
    display: inline-block;
    font-size: 1.5rem;
    line-height: 1;
  }

  .inline-link--icon-only .inline-link__icon {
    display: block;
    margin-inline-start: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-link {
      transition: none;
    }
  }
</style>
