---
import InlineLink from "./InlineLink.astro";

interface Props {
  index: number;
  title: string;
  href: string;
  description: string;
}

const { index, title, href, description } = Astro.props;
---

<li class="project">
  <span class="project-index" aria-hidden="true">
    {index}.
  </span>
  <h3>
    <InlineLink href={href} icon>
      {title}
    </InlineLink>
  </h3>
  <p>{description}</p>
</li>

<style>
  .project {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 1rem;
    row-gap: 0.5rem;
    padding-block: 1rem;
    border-block-start: 1px solid var(--color-hairline);
    font-size: 1.125rem;
  }

  .project:last-child {
    border-block-end: 1px solid var(--color-hairline);
  }

  .project-index {
    grid-column: 1;
    grid-row: 1;
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1;
    color: var(--foreground-3);
    align-self: baseline;
  }

  h3,
  p {
    grid-column: 2;
    margin: 0;
    font-size: inherit;
    font-weight: normal;
  }

  h3 {
    grid-row: 1;
    align-self: baseline;
    font-size: 2.5rem;
  }

  p {
    grid-row: 2;
  }

  @media (max-width: 767px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
    }

    h3,
    p {
      grid-column: 1;
    }

    h3 {
      grid-row: 2;
    }

    p {
      grid-row: 3;
    }
  }
</style>
