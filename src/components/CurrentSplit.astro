---
import { workouts } from "../data/workouts.json";

function exerciseLabel(index: number): string {
  let letters = "";
  for (
    let number = index + 1;
    number > 0;
    number = Math.floor((number - 1) / 26)
  ) {
    letters = String.fromCharCode(65 + ((number - 1) % 26)) + letters;
  }
  return `${letters}1`;
}
---

<section class="split" aria-labelledby="split-heading">
  <h2 id="split-heading">Current split</h2>
  <div class="training-log" data-workout-split>
    <label class="workout-control" hidden>
      <span class="workout-title" aria-hidden="true">
        <span data-workout-name>{workouts[0]?.name}</span>
        <span class="session-focus" data-workout-focus>
          {workouts[0]?.focus}
        </span>
      </span>
      <select
        class="workout-selector"
        aria-label="Select workout"
        aria-controls="workout-details"
      >
        {workouts.map((workout, index) => (
          <option
            value={index}
            data-name={workout.name}
            data-focus={workout.focus}
          >
            {workout.name} — {workout.focus}
          </option>
        ))}
      </select>
    </label>

    <div id="workout-details">
      {workouts.map((workout) => (
        <div
          class="session"
          data-session
          role="region"
          aria-label={`${workout.name} — ${workout.focus}`}
        >
          <h3 class="session-heading">
            {workout.name}
            <span class="session-focus">{workout.focus}</span>
          </h3>
          {workout.exercises.length > 0 ? (
            <table>
              <caption class="sr-only">{workout.name} exercises</caption>
              <thead>
                <tr>
                  <th scope="col">Exercise</th>
                  <th scope="col">Sets</th>
                  <th scope="col">Reps</th>
                </tr>
              </thead>
              <tbody>
                {workout.exercises.map((exercise, exerciseIndex) => (
                  <tr>
                    <th scope="row">
                      <span class="exercise-index">
                        {exerciseLabel(exerciseIndex)}
                      </span>
                      {exercise.name}
                    </th>
                    <td>
                      {exercise.sets}
                      <span class="sr-only"> sets</span>
                    </td>
                    <td>
                      {exercise.reps}
                      <span class="sr-only"> reps</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="empty">No exercises. Take the day to recover.</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-workout-split]")
    .forEach((split) => {
      const control = split.querySelector<HTMLElement>(".workout-control");
      const selector =
        split.querySelector<HTMLSelectElement>(".workout-selector");
      const panels = Array.from(
        split.querySelectorAll<HTMLElement>("[data-session]"),
      );
      if (!control || !selector || panels.length === 0) return;

      const workoutName = split.querySelector<HTMLElement>(
        "[data-workout-name]",
      );
      const workoutFocus = split.querySelector<HTMLElement>(
        "[data-workout-focus]",
      );

      function selectWorkout() {
        const option = selector?.selectedOptions[0];
        if (workoutName) workoutName.textContent = option?.dataset.name ?? "";
        if (workoutFocus)
          workoutFocus.textContent = option?.dataset.focus ?? "";
        panels.forEach((panel, index) => {
          panel.hidden = index !== Number(selector?.value);
        });
      }

      split
        .querySelectorAll<HTMLElement>(".session-heading")
        .forEach((heading) => {
          heading.hidden = true;
        });
      selector.addEventListener("change", selectWorkout);
      selectWorkout();
      control.hidden = false;
    });
</script>

<style>
  .split {
    margin-block-end: 4rem;
  }

  .training-log {
    --foreground-1: var(--light-1);
    --foreground-2: var(--light-2);
    --foreground-3: var(--light-3);
    --panel-hairline: rgb(255 255 255 / 0.12);
    border: 1px solid var(--panel-hairline);
    font-size: 18px;
    background: var(--dark-1);
    color: var(--foreground-2);
  }

  .workout-control {
    position: relative;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    background: var(--dark-2);
    border-block-end: 1px solid var(--panel-hairline);
    cursor: pointer;
    transition: background-color 160ms var(--bezier);
  }

  /* Dark surfaces communicate depth through lightness, not shadows. */
  .workout-control:hover,
  .workout-control:has(.workout-selector:focus-visible) {
    background: color-mix(in srgb, var(--dark-2) 94%, white);
  }

  .workout-control:not([hidden]) {
    display: flex;
  }

  .workout-control::after {
    content: "";
    flex: 0 0 auto;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    background-color: var(--light-1);
    mask: url("/icons/phosphor/caret-down-bold.svg") center / contain no-repeat;
    pointer-events: none;
  }

  .workout-title {
    color: var(--foreground-1);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  .workout-selector {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    font: inherit;
    cursor: pointer;
  }

  .workout-selector option {
    font-size: 18px;
    color: var(--dark-1);
    background: var(--color-background);
  }

  .workout-control:has(.workout-selector:focus-visible) {
    outline: 2px solid var(--light-1);
    outline-offset: 0.25rem;
  }

  #workout-details {
    display: grid;
    gap: 2rem;
  }

  .session-heading {
    margin: 0 -1rem;
    padding: 1rem;
    background: var(--dark-2);
    color: var(--foreground-1);
    font-size: 18px;
    line-height: 1.2;
    font-weight: 700;
  }

  .session {
    padding: 0 1rem 0.5rem;
  }

  .session table,
  .session .empty {
    margin-block-start: 1.5rem;
  }

  .session-focus {
    margin-inline-start: 0.5rem;
    color: var(--foreground-3);
    font-size: 18px;
    font-weight: 400;
  }

  .empty {
    margin: 0;
    padding-block: 1rem;
    color: var(--foreground-2);
  }

  table {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content max-content;
    width: 100%;
    border-spacing: 0;
    text-align: start;
    font-size: inherit;
  }

  thead,
  tbody,
  tr {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  th,
  td {
    align-content: baseline;
    padding-block: 0.5rem;
    text-align: start;
  }

  th:not(:first-child),
  td {
    padding-inline-start: 1rem;
    text-align: end;
  }

  tr > :nth-child(2) {
    text-align: center;
  }

  thead th {
    padding-block: 0 0.5rem;
    color: var(--foreground-3);
    font-size: inherit;
  }

  thead tr {
    border-block-end: 1px solid var(--panel-hairline);
  }

  tbody tr + tr {
    border-block-start: 1px dashed var(--panel-hairline);
  }

  tbody th {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    color: inherit;
  }

  th {
    font-weight: 400;
  }

  td,
  .exercise-index {
    font-variant-numeric: tabular-nums;
  }

  td {
    color: var(--foreground-2);
    white-space: nowrap;
  }

  .exercise-index {
    color: var(--foreground-3);
    font-size: inherit;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
