---
import "../styles/global.css";
import Project from "../components/Project.astro";
import CurrentSplit from "../components/CurrentSplit.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Saloojee</title>
  </head>
  <body class="wrapper">
    <main>
      <section class="intro">
        <h1>Abdurahmaan Saloojee</h1>

        <p>
          I operate a small software development consultancy called Omniwerx. I
          design websites and build marketing systems for small companies that
          need faster solutions and stronger visual identity.
        </p>
        <p>
          I'm currently a software engineer at Pre-Script, a principles-based
          fitness education company. We're dedicated to pushing the boundaries
          of human performance by forging better coaches and creating better
          athletes.
        </p>
        <p>
          Outside that, I'm trying to learn systems programming: Rust, Go,
          Kubernetes, and Nix.
        </p>
      </section>
      <section class="work">
        <h2>Work</h2>
        <ol class="projects">
          <Project
            index={1}
            title="Project one"
            href="https://example.com/#project-one"
            description="A short sentence describing the first project."
          />
          <Project
            index={2}
            title="Project two"
            href="https://example.com/#project-two"
            description="A short sentence describing the second project."
          />
          <Project
            index={3}
            title="Project three"
            href="https://example.com/#project-three"
            description="A short sentence describing the third project."
          />
        </ol>
      </section>
      <CurrentSplit />
    </main>
  </body>
</html>
