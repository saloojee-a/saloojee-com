---
import "../styles/global.css";
import Project from "../components/Project.astro";
import CurrentSplit from "../components/CurrentSplit.astro";
import InlineLink from "../components/InlineLink.astro";
import Footer from "../components/Footer.astro";

const title = "Abdurahmaan Saloojee | Software Developer";
const description =
  "Founder of Omniwerx and Software Engineer at Pre-Script";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saloojee" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="4800" />
    <meta property="og:image:height" content="2520" />
    <meta property="og:image:alt" content="Abdurahmaan Saloojee" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Abdurahmaan Saloojee" />
  </head>
  <body class="wrapper">
    <main>
      <section class="intro">
        <header class="intro-heading">
          <h1>
            <span>Abdurahmaan</span>
            <span class="intro-surname">
              <span>Saloojee</span>
              <img
                src="/threshold-headshot.png"
                alt=""
                width="683"
                height="682"
                fetchpriority="high"
              />
            </span>
          </h1>
        </header>

        <p>
          I operate a small software development consultancy called{" "}
          <InlineLink href="https://www.omniwerx.io">Omniwerx</InlineLink>. I
          design websites and build marketing systems for small companies that
          need faster solutions and stronger visual identity.
        </p>
        <p>
          I'm currently a software engineer at{" "}
          <InlineLink href="https://www.pre-script.com">Pre-Script</InlineLink>,
          a principles-based fitness education company. We're dedicated to
          pushing the boundaries of human performance by forging better coaches
          and creating better athletes.
        </p>
        <p>
          Outside that, I'm trying to learn systems programming: Rust, Go,
          Kubernetes, and Nix.
        </p>
      </section>
      <section class="work">
        <h2>Work</h2>
        <ol class="projects">
          <Project
            index={1}
            title="Omniwerx"
            href="https://www.omniwerx.io"
            description="Landing page for my consulting business."
          />
          <Project
            index={2}
            title="Pre-Script"
            href="https://www.pre-script.com"
            description="Ongoing development and marketing client work."
          />
          <Project
            index={3}
            title="JC Health & Performance"
            href="https://www.jc-healthperformance.ca"
            description="Early project for a standalone site and brand kit."
          />
        </ol>
      </section>
      <CurrentSplit />
      <section class="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Contact</h2>
        <p>
          Have a project in mind, or just want to talk shop? Email me at{" "}
          <InlineLink href="mailto:a@saloojee.com">a@saloojee.com</InlineLink>.
        </p>
        <ul class="contact-links">
          <li>
            <InlineLink
              href="https://www.github.com/saloojee-a"
              icon="github-logo"
              iconOnly
              aria-label="GitHub"
            />
          </li>
          <li>
            <InlineLink
              href="https://www.instagram.com/saloojee_a"
              icon="instagram-logo"
              iconOnly
              aria-label="Instagram"
            />
          </li>
          <li>
            <InlineLink
              href="https://www.linkedin.com/in/abdurahmaan-saloojee"
              icon="linkedin-logo"
              iconOnly
              aria-label="LinkedIn"
            />
          </li>
          <li>
            <InlineLink
              href="https://www.x.com/saloojee_a"
              icon="x-logo"
              iconOnly
              aria-label="X"
            />
          </li>
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
