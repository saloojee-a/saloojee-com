{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saloojee-com-dev",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/fonts/*"],
    "not_found_handling": "404-page",
  },
  "env": {
    "production": {
      "name": "saloojee-com",
      "vars": {
        "ENVIRONMENT": "production",
      },
      "workers_dev": false,
      "routes": [
        {
          "pattern": "saloojee.com",
          "custom_domain": true,
        },
        {
          "pattern": "www.saloojee.com",
          "custom_domain": true,
        },
      ],
    },
    "preview": {
      "name": "saloojee-com-preview",
      "vars": {
        "ENVIRONMENT": "preview",
      },
      "workers_dev": true,
    },
  },
}
